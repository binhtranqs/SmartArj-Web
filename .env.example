# SmartArj local configuration example
# Copy these values into your shell, IDE run configuration, or server environment.

SMARTARJ_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=SmartAgri_PRJ301;encrypt=true;trustServerCertificate=true
SMARTARJ_DB_USER=sa
SMARTARJ_DB_PASSWORD=your_sql_server_password

SMARTARJ_VNP_TMN_CODE=your_vnpay_tmn_code
SMARTARJ_VNP_HASH_SECRET=your_vnpay_hash_secret
SMARTARJ_VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
SMARTARJ_VNP_RETURN_URL=http://localhost:8080/SmartArj/payment/vnpay/return

